{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailPurge",
  "version": "0.1.0",
  "identifier": "com.mailpurge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MailPurge - Nettoyage Sécurisé de Boîtes Mails",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
